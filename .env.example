DB_HOST=localhost
DB_PORT=3306
DB_NAME=crabkidskenyaco_pos
DB_USER=dashboard_reader
DB_PASS=your_password_here
BUSINESS_ID=1

# POS web address -- the call center order form sends M-Pesa STK pushes
# through the POS's own /mpesa/stkpush endpoint (which uses the POS's Daraja
# credentials and callback). Defaults to https://pos.crabkidskenya.co.ke.
POS_BASE_URL=https://pos.crabkidskenya.co.ke
# Optional: IP to connect to the POS on if the server can't reach its own
# public address (127.0.0.1 is tried automatically).
# POS_CONNECT_IP=

# Dashboard login (single shared account gating the whole site).
# AUTH_PASSWORD_HASH must be a bcrypt hash, not a plaintext password --
# generate one with: php -r "echo password_hash('yourpassword', PASSWORD_DEFAULT).PHP_EOL;"
AUTH_USERNAME=crabkids
AUTH_PASSWORD_HASH=
